# Production Environment Variables
# Copy this file to .env.prod and fill in the values

# Domain Configuration
DOMAIN=example.com

# MySQL Configuration
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=symfony_app
MYSQL_USER=symfony
MYSQL_PASSWORD=change_me_password

# Sentry Configuration
SENTRY_DSN=http://sentry-key@sentry.example.com/1
SENTRY_SECRET_KEY=change_me_secret_key
SENTRY_DB_PASSWORD=change_me_sentry_password
